generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  name      String
  bio       String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts                  Post[]
  notificationsReceived  Notification[] @relation("UserNotifications")
  notificationsTriggered Notification[] @relation("UserActions")
}

model Post {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([authorId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   // Recipient of notification
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String   // User who triggered action
  actor     User     @relation("UserActions", fields: [actorId], references: [id], onDelete: Cascade)
  type      String   // "MENTION", "NEW_POST"
  entityId  String?  // Post ID
  content   String   // Notification snippet
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}
